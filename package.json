{
  "name": "@likemiens/voice-dock",
  "version": "1.1.0",
  "description": "The control bar of a live voice session as a React component: status, microphone, screen sharing, exit and a menu, drawn as beads on one thread.",
  "keywords": [
    "react",
    "react-component",
    "voice",
    "call",
    "call-controls",
    "toolbar",
    "mute",
    "screen-share",
    "svg",
    "spring-animation"
  ],
  "homepage": "https://likemiens.com/ui/voice-dock",
  "bugs": {
    "url": "https://github.com/Likemiens/voice-dock/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Likemiens/voice-dock.git"
  },
  "license": "MIT",
  "author": {
    "name": "Likemiens",
    "url": "https://github.com/Likemiens"
  },
  "type": "module",
  "main": "./voice-dock.js",
  "files": [
    "voice-dock.js",
    "voice-dock.d.ts",
    "voice-dock.css"
  ],
  "peerDependencies": {
    "react": ">=19.2"
  },
  "module": "./voice-dock.js",
  "types": "./voice-dock.d.ts",
  "exports": {
    ".": {
      "types": "./voice-dock.d.ts",
      "import": "./voice-dock.js"
    },
    "./voice-dock.css": "./voice-dock.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  }
}
